DOMAIN=notice.example.com
DATABASE_PATH=/app/var/pnu_notice.sqlite3
APP_BASE_URL=https://notice.example.com
APP_SECRET=generate-a-random-value-with-openssl-rand-hex-32
POLL_INTERVAL_MINUTES=15
BACKFILL_START=2026-07-01T00:00:00+09:00
REQUESTS_PER_SECOND=1
HTTP_TIMEOUT_SECONDS=30
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
RESEND_API_KEY=
FROM_NAME=PNU Notice
FROM_EMAIL=notice@example.com
ADMIN_EMAIL=
DIGEST_HOURS=10,13,16,19
WEEKLY_DIGEST_WEEKDAY=4
WEEKLY_DIGEST_HOUR=19
TOKEN_TTL_HOURS=24
VERIFICATION_COOLDOWN_SECONDS=300
MAX_DELIVERY_ATTEMPTS=5

# Cloudflare Turnstile on /subscribe; TURNSTILE_HOSTNAMES is the public hostname only (never localhost)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=notice.example.com

# Only for compose.tunnel.yaml: uid/gid owning ./cloudflared (run `id -u` and `id -g`)
HOST_UID=1000
HOST_GID=1000
