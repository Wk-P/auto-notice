DATABASE_PATH=var/pnu_notice.sqlite3
APP_BASE_URL=http://localhost:8000
APP_SECRET=replace-with-a-long-random-secret
POLL_INTERVAL_MINUTES=60
BACKFILL_START=2026-07-01T00:00:00+09:00
REQUESTS_PER_SECOND=1
HTTP_TIMEOUT_SECONDS=30
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
RESEND_API_KEY=
FROM_NAME=PNU Notice
FROM_EMAIL=notice@example.com
ADMIN_EMAIL=
DIGEST_HOURS=10,13,16,19
WEEKLY_DIGEST_WEEKDAY=4
WEEKLY_DIGEST_HOUR=19
TOKEN_TTL_HOURS=24
VERIFICATION_COOLDOWN_SECONDS=300
MAX_DELIVERY_ATTEMPTS=5

# Cloudflare Turnstile on /subscribe; leave TURNSTILE_SECRET empty to disable (local development)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=
